{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/push-subscribe", "destination": "/api/push-send" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/bugs(.html)?",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive, nosnippet" }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/push-send",
      "schedule": "0 12 * * 3"
    },
    {
      "path": "/api/tour?cron=reconcile-payments",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/supply-closet?cron=loan-reminders",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/notifications?cron=todo-sweep",
      "schedule": "30 12 * * *"
    }
  ]
}
